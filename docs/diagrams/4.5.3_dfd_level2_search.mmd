    User -- query --> P41
    P41 -- normalized intent --> P42
    P42 <--> D4
    P42 -- candidate spans --> P43
    P43 <--> D3
    P43 -- merged spans --> P44
    P44 <--> D5
    P44 -- clip URLs --> User
    P44 -- record --> P45
    P45 --> D6

    User -- video_id + quality settings --> P61
    P61 <--> D2
    P61 -- valid source --> P62
    P62 -- bitrate / resolution / codec --> P63
    P63 -- compressed file --> P64
    P64 --> D8
